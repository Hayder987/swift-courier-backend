<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SwiftCourier Verification Code</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f5f6f8;
        font-family: Arial, Helvetica, sans-serif;
        color: #171717;
      }

      .wrapper {
        width: 100%;
        padding: 48px 16px;
        box-sizing: border-box;
      }

      .container {
        width: 100%;
        max-width: 540px;
        margin: 0 auto;
        background: #ffffff;
        border: 1px solid #e7e7e7;
        border-radius: 16px;
        overflow: hidden;
      }

      /* Header */

      .header {
        padding: 30px 36px;
        text-align: center;
        border-bottom: 1px solid #eeeeee;
      }

      .logo {
        display: inline-block;
        font-size: 27px;
        font-weight: 700;
        letter-spacing: -0.8px;
        color: #e50914;
      }

      .brand-dot {
        color: #111111;
      }

      /* Content */

      .content {
        padding: 44px 36px 40px;
        text-align: center;
      }

      .eyebrow {
        margin: 0 0 10px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: #e50914;
      }

      .title {
        margin: 0 0 14px;
        font-size: 26px;
        line-height: 1.25;
        font-weight: 700;
        letter-spacing: -0.5px;
        color: #111111;
      }

      .description {
        max-width: 420px;
        margin: 0 auto 30px;
        font-size: 15px;
        line-height: 1.7;
        color: #737373;
      }

      /* OTP */

      .otp-wrapper {
        margin: 0 auto 20px;
        max-width: 330px;
      }

      .otp-box {
        padding: 20px 24px;
        border-radius: 12px;
        background-color: #fff5f5;
        border: 1px solid #fecaca;
      }

      .otp-label {
        display: block;
        margin-bottom: 8px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #991b1b;
      }

      .otp {
        display: block;
        font-size: 34px;
        line-height: 1;
        font-weight: 700;
        letter-spacing: 9px;
        color: #e50914;
        padding-left: 9px;
        font-family:
          "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
      }

      .expiration {
        margin: 0 0 30px;
        font-size: 13px;
        line-height: 1.6;
        color: #737373;
      }

      .expiration strong {
        color: #404040;
      }

      /* Security */

      .security-note {
        padding: 16px 18px;
        text-align: left;
        border-radius: 10px;
        background-color: #fafafa;
        border: 1px solid #eeeeee;
      }

      .security-title {
        margin: 0 0 5px;
        font-size: 13px;
        font-weight: 700;
        color: #404040;
      }

      .security-text {
        margin: 0;
        font-size: 12px;
        line-height: 1.6;
        color: #737373;
      }

      /* Footer */

      .footer {
        padding: 24px 30px 28px;
        text-align: center;
        border-top: 1px solid #eeeeee;
        background-color: #fcfcfc;
      }

      .footer p {
        margin: 0;
        font-size: 12px;
        line-height: 1.6;
        color: #a3a3a3;
      }

      .footer .copyright {
        margin-top: 6px;
      }

      /* Mobile */

      @media only screen and (max-width: 480px) {
        .wrapper {
          padding: 24px 10px;
        }

        .header {
          padding: 26px 20px;
        }

        .content {
          padding: 36px 20px 32px;
        }

        .footer {
          padding: 22px 18px 24px;
        }

        .title {
          font-size: 23px;
        }

        .description {
          font-size: 14px;
        }

        .otp-box {
          padding: 18px 16px;
        }

        .otp {
          font-size: 29px;
          letter-spacing: 7px;
          padding-left: 7px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">
        <!-- Header -->
        <div class="header">
          <div class="logo">SwiftCourier<span class="brand-dot">.</span></div>
        </div>

        <!-- Content -->
        <div class="content">
          <p class="eyebrow">Security verification</p>

          <h1 class="title">Your verification code</h1>

          <p class="description">
            Use the verification code below to continue with your SwiftCourier
            account. This code is required to complete your request.
          </p>

          <!-- OTP -->
          <div class="otp-wrapper">
            <div class="otp-box">
              <span class="otp-label"> Verification code </span>

              <span class="otp"> <%= otp %> </span>
            </div>
          </div>

          <p class="expiration">
            This code will expire in
            <strong> <%= expirationMinutes || 5 %> minutes </strong>.
          </p>

          <!-- Security Notice -->
          <div class="security-note">
            <p class="security-title">Security notice</p>

            <p class="security-text">
              If you did not request this code, you can safely ignore this
              email. Never share your verification code with anyone.
            </p>
          </div>
        </div>

        <!-- Footer -->
        <div class="footer">
          <p>
            This is an automated message from SwiftCourier. Please do not reply
            to this email.
          </p>

          <p class="copyright">
            &copy; <%= new Date().getFullYear() %> SwiftCourier. All rights
            reserved.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
