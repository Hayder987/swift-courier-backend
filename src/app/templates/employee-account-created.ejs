<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>SwiftCourier Employee Account</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background: #f5f5f5;
        font-family: Arial, Helvetica, sans-serif;
        color: #222;
      }

      .wrapper {
        width: 100%;
        padding: 40px 15px;
      }

      .container {
        max-width: 600px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      }

      .header {
        background: #e50914;
        padding: 30px;
        text-align: center;
        color: #ffffff;
      }

      .logo {
        font-size: 28px;
        font-weight: 800;
        letter-spacing: 1px;
      }

      .content {
        padding: 35px;
      }

      .title {
        margin: 0 0 15px;
        font-size: 24px;
        font-weight: 700;
      }

      .text {
        font-size: 15px;
        line-height: 1.7;
        color: #555;
      }

      .credentials {
        margin: 25px 0;
        padding: 20px;
        background: #f8f8f8;
        border: 1px solid #eeeeee;
        border-radius: 8px;
      }

      .row {
        margin-bottom: 15px;
      }

      .row:last-child {
        margin-bottom: 0;
      }

      .label {
        display: block;
        margin-bottom: 5px;
        font-size: 12px;
        font-weight: 700;
        color: #777;
        text-transform: uppercase;
      }

      .value {
        font-size: 16px;
        font-weight: 600;
        color: #222;
      }

      .password {
        display: inline-block;
        padding: 8px 12px;
        border: 1px dashed #e50914;
        border-radius: 6px;
        background: #ffffff;
        color: #e50914;
        font-size: 16px;
        font-weight: 800;
        letter-spacing: 1px;
      }

      .warning {
        margin-top: 20px;
        padding: 15px;
        border-left: 4px solid #e50914;
        background: #fff4f4;
        color: #555;
        font-size: 14px;
        line-height: 1.6;
      }

      .footer {
        padding: 20px 35px;
        background: #fafafa;
        text-align: center;
        color: #888;
        font-size: 12px;
        line-height: 1.6;
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">
        <div class="header">
          <div class="logo">SwiftCourier</div>

          <div style="margin-top: 6px">
            Courier & Logistics Management Platform
          </div>
        </div>

        <div class="content">
          <h1 class="title">Welcome to SwiftCourier, <%= name %>!</h1>

          <p class="text">
            Your employee account has been successfully created by the
            SwiftCourier administration team.
          </p>

          <p class="text">You can use the following credentials to log in:</p>

          <div class="credentials">
            <div class="row">
              <span class="label"> Name </span>

              <span class="value"> <%= name %> </span>
            </div>

            <div class="row">
              <span class="label"> Email </span>

              <span class="value"> <%= email %> </span>
            </div>

            <div class="row">
              <span class="label"> Role </span>

              <span class="value"> <%= role %> </span>
            </div>

            <div class="row">
              <span class="label"> Account Status </span>

              <span class="value"> <%= status %> </span>
            </div>

            <div class="row">
              <span class="label"> Password </span>

              <span class="password"> <%= password %> </span>
            </div>
          </div>

          <div class="warning">
            <strong>Important:</strong>
            This password is provided by the administrator. Please log in using
            this password and change your password immediately after your first
            login.
          </div>

          <p class="text">
            For security reasons, please do not share your password with anyone.
          </p>
        </div>

        <div class="footer">
          © <%= new Date().getFullYear() %> SwiftCourier. All rights reserved.
        </div>
      </div>
    </div>
  </body>
</html>
