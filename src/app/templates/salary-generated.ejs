<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Salary Generated</title>
</head>

<body
  style="
    margin:0;
    padding:0;
    background:#f5f5f5;
    font-family:Arial,Helvetica,sans-serif;
  "
>

  <div
    style="
      max-width:600px;
      margin:40px auto;
      background:#ffffff;
      border-radius:12px;
      overflow:hidden;
      border:1px solid #eeeeee;
    "
  >

    <!-- Header -->

    <div
      style="
        background:#e50914;
        padding:25px;
        text-align:center;
      "
    >

      <h1
        style="
          margin:0;
          color:#ffffff;
          font-size:28px;
        "
      >
        SwiftCourier
      </h1>

      <p
        style="
          margin:8px 0 0;
          color:#ffffff;
          font-size:14px;
        "
      >
        Employee Salary Statement
      </p>

    </div>


    <!-- Content -->

    <div style="padding:30px;">

      <h2
        style="
          margin-top:0;
          color:#222222;
        "
      >
        Hello <%= name %>,
      </h2>

      <p
        style="
          color:#555555;
          line-height:1.6;
        "
      >
        Your salary for
        <strong>
          <%= month %>/<%= year %>
        </strong>
        has been generated successfully.
      </p>


      <!-- Salary -->

      <table
        width="100%"
        cellpadding="8"
        cellspacing="0"
        style="
          border-collapse:collapse;
          margin-top:20px;
        "
      >

        <tr>
          <td
            style="
              border-bottom:1px solid #eeeeee;
              color:#555555;
            "
          >
            Basic Salary
          </td>

          <td
            align="right"
            style="
              border-bottom:1px solid #eeeeee;
              font-weight:bold;
            "
          >
            ৳<%= basicSalary %>
          </td>
        </tr>


        <tr>
          <td
            style="
              border-bottom:1px solid #eeeeee;
              color:#555555;
            "
          >
            Total Allowance
          </td>

          <td
            align="right"
            style="
              border-bottom:1px solid #eeeeee;
              font-weight:bold;
            "
          >
            ৳<%= totalAllowance %>
          </td>
        </tr>


        <tr>
          <td
            style="
              border-bottom:1px solid #eeeeee;
              color:#555555;
            "
          >
            Delivery Earning
          </td>

          <td
            align="right"
            style="
              border-bottom:1px solid #eeeeee;
              font-weight:bold;
            "
          >
            ৳<%= deliveryEarning %>
          </td>
        </tr>


        <tr>
          <td
            style="
              border-bottom:1px solid #eeeeee;
              color:#555555;
            "
          >
            Bonus
          </td>

          <td
            align="right"
            style="
              border-bottom:1px solid #eeeeee;
              font-weight:bold;
            "
          >
            ৳<%= bonus %>
          </td>
        </tr>


        <tr>
          <td
            style="
              border-bottom:1px solid #eeeeee;
              color:#555555;
            "
          >
            Gross Salary
          </td>

          <td
            align="right"
            style="
              border-bottom:1px solid #eeeeee;
              font-weight:bold;
            "
          >
            ৳<%= grossSalary %>
          </td>
        </tr>


        <tr>
          <td
            style="
              border-bottom:1px solid #eeeeee;
              color:#555555;
            "
          >
            Total Deduction
          </td>

          <td
            align="right"
            style="
              border-bottom:1px solid #eeeeee;
              font-weight:bold;
            "
          >
            ৳<%= totalDeduction %>
          </td>
        </tr>


        <tr>

          <td
            style="
              padding-top:15px;
              color:#222222;
              font-size:18px;
              font-weight:bold;
            "
          >
            Net Salary
          </td>

          <td
            align="right"
            style="
              padding-top:15px;
              color:#e50914;
              font-size:20px;
              font-weight:bold;
            "
          >
            ৳<%= netSalary %>
          </td>

        </tr>

      </table>


      <div
        style="
          margin-top:25px;
          padding:15px;
          background:#fafafa;
          border-radius:8px;
        "
      >

        <p
          style="
            margin:0;
            color:#555555;
          "
        >
          Total Deliveries:
          <strong>
            <%= totalDeliveries %>
          </strong>
        </p>

        <p
          style="
            margin:8px 0 0;
            color:#555555;
          "
        >
          Successful Deliveries:
          <strong>
            <%= successfulDeliveries %>
          </strong>
        </p>

      </div>


      <p
        style="
          margin-top:30px;
          color:#777777;
          font-size:13px;
          line-height:1.6;
        "
      >
        Please login to your SwiftCourier account
        to view your complete salary information.
      </p>

    </div>


    <!-- Footer -->

    <div
      style="
        padding:20px;
        background:#fafafa;
        text-align:center;
      "
    >

      <p
        style="
          margin:0;
          color:#999999;
          font-size:12px;
        "
      >
        © <%= year %> SwiftCourier.
        All rights reserved.
      </p>

    </div>

  </div>

</body>
</html>