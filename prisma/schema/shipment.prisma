model Shipment {
  id                String             @id @default(uuid()) @db.Uuid
  trackingNumber    String             @unique
  customerId        String             @db.Uuid
  pickupCourierId   String?            @db.Uuid
  deliveryCourierId String?            @db.Uuid
  imageUrl          String?
  imagePublicId     String?
  parcelName        String
  description       String             @db.Text
  parcelWeightGM    Decimal            @db.Decimal(8, 2)
  deliveryFee       Decimal?           @db.Decimal(10, 2)
  deliveryDistance  Decimal?           @db.Decimal(10, 2)
  status            ShipmentStatus     @default(CREATED)
  type              ShipmentType       @default(NEW)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  onboardingTime    DateTime?

  pickupAddress     Json
  pickupLat         Decimal            @db.Decimal(10, 7)
  pickupLng         Decimal            @db.Decimal(10, 7)

  deliveryAddress   Json
  deliveryLng       Decimal?           @db.Decimal(10, 7)
  deliveryLat       Decimal?           @db.Decimal(10, 7)

  pickupZoneId      String?            @db.Uuid
  deliveryZoneId    String?            @db.Uuid

  customer          User               @relation("CustomerShipments", fields: [customerId], references: [id])
  pickupCourier     User?              @relation("CourierPickupShipments", fields: [pickupCourierId], references: [id])
  deliveryCourier   User?              @relation("CourierDeliveryShipments", fields: [deliveryCourierId], references: [id])
  pickupZone        Zone?              @relation("PickupZone", fields: [pickupZoneId], references: [id])
  deliveryZone      Zone?              @relation("DeliveryZone", fields: [deliveryZoneId], references: [id])
  
  tracking          ShipmentTracking[]
  payments          Payment[]
  notification      Notification[]
  courierEarnings   CourierEarning[]

  @@index([pickupZoneId])
  @@index([deliveryZoneId])
  @@index([type])
  @@index([customerId])
  @@index([pickupCourierId])
  @@index([deliveryCourierId])
  @@index([status])
  @@index([createdAt])
  @@map("shipments")
}
